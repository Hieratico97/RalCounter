<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_creature"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">


        <!-- ═══════════════════════════════════════════
             SPELL COUNTERS ROW (Storm + Inst/Sorc)
        ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- Storm counter -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="#1A0A00"
                app:cardCornerRadius="14dp"
                app:strokeColor="#FF6000"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storm_count_label"
                        android:textColor="#FF6000"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvStormCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/storm_count_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStormMinus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:padding="0dp"
                            app:backgroundTint="#FF6000"
                            app:cornerRadius="18dp" />

                        <View android:layout_width="8dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStormPlus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:padding="0dp"
                            app:backgroundTint="#FF6000"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Instant/Sorcery counter -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                app:cardBackgroundColor="#000D1A"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/lightning_cyan"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inst_sorc_label"
                        android:textColor="@color/lightning_cyan"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvInstSorcCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="0.9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inst_sorc_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstSorcMinus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="−"
                            android:textSize="18sp"
                            android:padding="0dp"
                            app:backgroundTint="@color/lightning_cyan"
                            app:cornerRadius="18dp" />

                        <View android:layout_width="8dp" android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstSorcPlus"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textSize="18sp"
                            android:padding="0dp"
                            app:backgroundTint="@color/lightning_cyan"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Other spells button (only increases Storm) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOtherSpell"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/other_spell_btn"
            android:textColor="@color/text_secondary"
            app:backgroundTint="#2A2A2A"
            app:cornerRadius="12dp" />

        <!-- ═══════════════════════════════════════════
             CRIATURA SECTION (visible only when MONSOON_MAGE)
        ═══════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/sectionCreature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <!-- Coin flip button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCastSpell"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/cast_spell"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:backgroundTint="@color/izzet_red"
                app:cornerRadius="14dp"
                app:elevation="4dp" />

            <!-- Flip result card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFlipResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/creature_card_bg"
                app:cardCornerRadius="12dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/gold">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvFlipResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ ¡CARA!"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/win_color" />

                    <TextView
                        android:id="@+id/tvFlipSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flip_win_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTransform"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/transform_ral"
                        android:visibility="gone"
                        app:backgroundTint="@color/lightning_cyan"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Self-damage display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/self_damage_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSelfDamage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="0"
                    android:textColor="@color/lose_color"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- ═══════════════════════════════════════════
             PLANESWALKER SECTION (visible only when LEYLINE_PRODIGY)
        ═══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sectionPlaneswalker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/planeswalker_card_bg"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/lightning_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Loyalty row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loyalty_label"
                            android:textColor="@color/lightning_cyan"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvLoyalty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2"
                            android:textColor="@color/white"
                            android:textSize="56sp"
                            android:textStyle="bold"
                            android:lineSpacingMultiplier="0.85" />
                    </LinearLayout>

                    <!-- Flip back button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlipBack"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:icon="@drawable/ic_flip_arrow"
                        app:iconSize="28dp"
                        app:iconTint="@color/gold"
                        app:backgroundTint="#2A1B02"
                        app:strokeColor="@color/gold"
                        app:strokeWidth="1dp"
                        app:cornerRadius="24dp" />
                </LinearLayout>

                <!-- Loyalty ability buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlusOne"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="+1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/lightning_cyan"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinusTwo"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="−2"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/izzet_red"
                        app:cornerRadius="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinusEight"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="−8"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="#6A0DAD"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Ability descriptions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="@string/ability_plus_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="@string/ability_minus2_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="@string/ability_minus8_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════
             LIFE TOTAL
        ═══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#2A0505"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/izzet_red"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="18dp"
                android:paddingHorizontal="24dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/life_total_label"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLifeMinus"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="−"
                    android:textSize="28sp"
                    android:padding="0dp"
                    app:backgroundTint="@color/izzet_red"
                    app:cornerRadius="28dp" />

                <TextView
                    android:id="@+id/tvLifeTotal"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="40"
                    android:textColor="@color/white"
                    android:textSize="58sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLifePlus"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="+"
                    android:textSize="28sp"
                    android:padding="0dp"
                    app:backgroundTint="@color/izzet_red"
                    app:cornerRadius="28dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════
             MANA POOL (integrated in same tab)
        ═══════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/planeswalker_card_bg"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/lightning_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/mana_pool_label"
                        android:textColor="@color/lightning_cyan"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mana_total_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalMana"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/gold_bright"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpendAll"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="@string/spend_all"
                        android:textSize="10sp"
                        android:textColor="@color/lose_color"
                        app:strokeColor="@color/lose_color"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- 3 Columns for compact Mana UI -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Blue -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_mana_blue" />
                        <TextView android:id="@+id/tvBlueCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" android:layout_marginVertical="4dp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnBlueMinus" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="32dp" android:layout_height="32dp" android:text="−" android:padding="0dp" app:backgroundTint="@color/mana_blue" app:cornerRadius="16dp" />
                            <View android:layout_width="4dp" android:layout_height="1dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnBluePlus" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="32dp" android:layout_height="32dp" android:text="+" android:padding="0dp" app:backgroundTint="@color/mana_blue" app:cornerRadius="16dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Red -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_mana_red" />
                        <TextView android:id="@+id/tvRedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" android:layout_marginVertical="4dp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnRedMinus" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="32dp" android:layout_height="32dp" android:text="−" android:padding="0dp" app:backgroundTint="@color/mana_red" app:cornerRadius="16dp" />
                            <View android:layout_width="4dp" android:layout_height="1dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnRedPlus" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="32dp" android:layout_height="32dp" android:text="+" android:padding="0dp" app:backgroundTint="@color/mana_red" app:cornerRadius="16dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Generic -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_mana_generic" />
                        <TextView android:id="@+id/tvGenericCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" android:layout_marginVertical="4dp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnGenericMinus" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="32dp" android:layout_height="32dp" android:text="−" android:padding="0dp" app:backgroundTint="@color/mana_generic" app:cornerRadius="16dp" />
                            <View android:layout_width="4dp" android:layout_height="1dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnGenericPlus" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="32dp" android:layout_height="32dp" android:text="+" android:padding="0dp" app:backgroundTint="@color/mana_generic" app:cornerRadius="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ═══════════════════════════════════════════
             ACTION BUTTONS
        ═══════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewTurn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/new_turn"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#1C2830"
                app:strokeColor="@color/gold"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewGame"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/new_game"
            android:textColor="@color/izzet_red"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="@color/izzet_red"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            android:letterSpacing="0.1" />

    </LinearLayout>
</ScrollView>
