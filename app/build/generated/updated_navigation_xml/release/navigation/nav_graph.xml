<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/nav_graph"
app:startDestination="@id/setupFragment" >
<fragment
    android:id="@+id/setupFragment"
    android:name="com.monsoonmage.ralcounter.ui.setup.SetupFragment"
    android:label="Setup" >

    <action
        android:id="@+id/action_setup_to_combo"
        app:destination="@id/comboFragment"
        app:popUpTo="@id/setupFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/comboFragment"
    android:name="com.monsoonmage.ralcounter.ui.combo.ComboFragment"
    android:label="Combo" >

    <action
        android:id="@+id/action_combo_to_setup"
        app:destination="@id/setupFragment"
        app:popUpTo="@id/comboFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/flipLogFragment"
    android:name="com.monsoonmage.ralcounter.ui.fliplog.FlipLogFragment"
    android:label="Historial" />
</navigation>